<div id="search" class="relative mt-2 h-full overflow-hidden"></div>

<script>
  import { PagefindUI } from '@pagefind/default-ui'

  const isDev = import.meta.env.DEV
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('#search')) {
      return
    }
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      bundlePath: isDev ? '/dist/pagefind/' : '/pagefind/',
      resetStyles: false,
      excerptLength: 50,
      processResult: isDev
        ? function (result: any) {
            if (result.meta.image) {
              result.meta.image = 'dist/' + result.meta.image
            }

            result.url = result.raw_url
            result.sub_results.forEach((subResult: any) => {
              subResult.url = subResult.url.replace('dist/', '')
            })

            return result
          }
        : undefined,
    })
  })
</script>

