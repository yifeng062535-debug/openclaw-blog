---
import NavHead from '@components/nav-header.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { getAllPosts } from '@utils/all-posts'

const allPosts = await getAllPosts()

const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter((tag) => tag) as string[]
const tagContent = uniqueTags
  .map((tag) => {
    const tagPost = allPosts.filter((post) => post.data.tags && post.data.tags.includes(tag))

    return {
      tag,
      count: tagPost.length,
    }
  })
  .sort((a, b) => b.count - a.count) // 按使用频率排序

const title = '主题标签'
const description = '从标签维度查看 OpenClaw 教程内容，快速进入同一条学习支线'
---

<BaseLayout title={title} description={description}>
  <NavHead />
  <main class="pb-8">
    <section class="mt-4 rounded-[2rem] border border-white/40 bg-white/72 p-6 dark:border-white/10 dark:bg-slate-950/70">
      <p class="font-mono text-xs uppercase tracking-[0.32em] text-cyan-700 dark:text-cyan-300">Tags</p>
      <h1 class="mt-3 text-3xl font-semibold text-slate-950 dark:text-white">{title}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
    </section>
    <section class="mt-6 grid grid-cols-3 gap-5 px-2 pb-5 pt-1 max-[768px]:grid-cols-2 min-[1500px]:grid-cols-4">
      {
        tagContent.map((item) => (
          <a
            href={'/tags/' + item.tag}
            class="group flex justify-between gap-2 rounded-[1.25rem] border border-slate-200/70 bg-white/72 px-5 py-4 shadow-[0_24px_80px_-46px_rgba(15,23,42,0.7)] dark:border-white/10 dark:bg-slate-950/70"
          >
            <span class="truncate">{item.tag}</span>
            <span class="text-primary-dark dark:text-primary-light">{item.count}</span>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>
