---
import NavHeader from '@components/nav-header.astro'
import BaseLayout from '@layouts/base-layout.astro'

const title = '404 / Signal Lost'
const description = '你访问的信号节点不存在，或者已经被重新归档'
---

<BaseLayout title={title} description={description}>
  <NavHeader />
  <main class="pb-8">
    <section class="mt-8 rounded-[2rem] border border-white/40 bg-white/72 px-6 py-14 text-center dark:border-white/10 dark:bg-slate-950/70">
      <p class="font-mono text-xs uppercase tracking-[0.32em] text-cyan-700 dark:text-cyan-300">Signal Lost</p>
      <h1 class="mt-4 text-5xl font-semibold text-slate-950 dark:text-white">404</h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-600 dark:text-slate-300">{description}</p>
      <a
        href="/"
        class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white no-underline dark:bg-cyan-300 dark:text-slate-950"
      >
        返回首页
      </a>
    </section>
  </main>
</BaseLayout>
